# ─── Painel (apps/admin) e extensão (apps/chrome-extension) — valores PÚBLICOS ───
# Supabase → Settings → API. A chave anon/publishable é pública por desenho (protegida por login + RLS).
# NUNCA coloque aqui a service_role key, tokens da Meta ou senhas.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=
# Opcional: nome exibido na extensão
VITE_EXTENSION_NAME=

# ─── Edge Functions (NÃO vão para este arquivo) ───
# Defina com: supabase secrets set NOME=valor   (ou Dashboard → Edge Functions → Secrets)
#   WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_SECRET, WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
#   WHATSAPP_GRAPH_VERSION (opcional, padrão v23.0), ADMIN_ORIGINS (ex.: https://seu-painel.netlify.app)
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem automaticamente nas Edge Functions.

# ─── Worker local: veja apps/local-worker/.env.example ───

# ─── Testes de banco (opcional) ───
TEST_PG_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
