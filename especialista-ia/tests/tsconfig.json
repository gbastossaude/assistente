{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "../node_modules/.cache/tsc-tests",
    "types": [
      "node"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "rootDir": ".."
  },
  "include": [
    "**/*.ts",
    "../supabase/functions/_shared/**/*.ts"
  ],
  "references": [
    {
      "path": "../packages/shared"
    },
    {
      "path": "../packages/ai-core"
    },
    {
      "path": "../apps/local-worker"
    }
  ],
  "exclude": [
    "../supabase/functions/_shared/deno-env.ts"
  ]
}