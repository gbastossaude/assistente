{
  "name": "@especialista/local-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Worker local: processa a fila do Supabase com Ollama (sem expor a porta do Ollama) e indexa documentos.",
  "scripts": {
    "start": "node --import tsx src/main.ts start",
    "once": "node --import tsx src/main.ts once",
    "doctor": "node --import tsx src/main.ts doctor",
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@especialista/ai-core": "0.1.0",
    "@especialista/shared": "0.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.296",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2"
  }
}
