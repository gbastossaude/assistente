# ─── Worker local (computador que executa o Ollama) ───
# Projeto Supabase: Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon/publishable). NUNCA coloque a service_role key aqui.
SUPABASE_ANON_KEY=
# Conta de máquina criada no painel (Colaboradores → papel "Worker local")
WORKER_EMAIL=worker@suacorretora.com.br
WORKER_PASSWORD=
# Identificador desta máquina (letras, números, ponto, hífen)
WORKER_ID=worker-escritorio

# ─── Ollama (somente local; não exponha a porta 11434) ───
OLLAMA_URL=http://127.0.0.1:11434
# Usados apenas até o worker receber a configuração do painel (Configurações → IA)
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# ─── Desempenho ───
# Perguntas processadas em paralelo (1 recomendado em CPU)
WORKER_CONCURRENCY=1
# Consulta periódica da fila (segundos) — o Realtime acorda o worker na hora; isto é a garantia
WORKER_POLL_SECONDS=15

# ─── OCR local opcional (requer Tesseract + Poppler instalados) ───
OCR_ENABLED=false
OCR_LANGUAGE=por

# ─── Logs (sem conteúdo de perguntas) ───
LOG_LEVEL=info
LOG_DIR=
