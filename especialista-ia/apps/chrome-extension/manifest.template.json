{
  "manifest_version": 3,
  "name": "Especialista IA — Planos de Saúde",
  "short_name": "Especialista IA",
  "version": "0.0.0",
  "description": "Painel lateral para consultar as regras de planos de saúde da corretora (uso interno). Não lê suas conversas.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "action": {
    "default_title": "Abrir o Especialista IA",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
