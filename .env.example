# ─── Banco de dados (PostgreSQL local ou Supabase: botão "Connect" → Session pooler) ───
# Não é preciso acrescentar ?sslmode=… — conexões com o Supabase já usam SSL automaticamente.
DATABASE_URL=postgres://besmart:besmart@localhost:5432/besmart
# Opcional: certificado do Supabase (Project Settings → Database → SSL Configuration → Download)
# para também verificar o certificado. Cole o PEM (quebras de linha podem ser escritas como \n).
DATABASE_CA_CERT=
# Força SSL em outros provedores (true/false)
DATABASE_SSL=
# Usado apenas pelos testes de integração
TEST_DATABASE_URL=postgres://besmart:besmart@localhost:5432/besmart_test

# ─── Autenticação ───
# Gere com: openssl rand -base64 48
AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Duração da sessão em horas
SESSION_TTL_HOURS=12

# ─── Armazenamento de documentos ───
# "local" (pasta privada fora de /public) ou "supabase" (bucket privado)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/private
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documentos
# Tamanho máximo de upload em MB
UPLOAD_MAX_MB=25

# ─── Rotina diária (alertas/automações). Chamar POST /api/cron/sweep com header "Authorization: Bearer <CRON_SECRET>" ───
CRON_SECRET=troque-por-um-segredo

# ─── Assistente IA (opcional). Sem chave, o assistente usa o roteador determinístico local ───
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ─── Fuso horário de negócio ───
APP_TIMEZONE=America/Sao_Paulo
